[sub_resource type="GDScript" id="GDScript_v481m"]
script/source = "extends AnimatedSprite2D

@onready var hero : = get_parent()
var last_pos

func _ready() -> void:
	last_pos = hero.global_position
	hero.attack.connect(play.bind(\"attack\"))
	hero.hit.connect(play.bind(\"hurt\"))

func _process(_delta: float) -> void:
	if last_pos != hero.global_position:
		play(\"walk\")
		last_pos = hero.global_position
	if not is_playing():
		play(\"idle\")
"

