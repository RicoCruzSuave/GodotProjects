[sub_resource type="GDScript" id="GDScript_hb1on"]
script/source = "extends Node2D

@export var cooldown_timer : = 10.0
@export var pierce : = INF
@onready var effect: Node2D = $Effect
@onready var range_area: Area2D = $Range

var current_cooldown_timer : = cooldown_timer
var ready_to_use : = false
var can_use : = false

func _physics_process(_delta: float) -> void:
	if range_area.has_overlapping_bodies():
		can_use = true

func cooldown(amount : float) -> void:
	current_cooldown_timer -= amount
	if current_cooldown_timer <= 0.0:
		#if range_area.has_overlapping_bodies():
		current_cooldown_timer = cooldown_timer
		ready_to_use = true
		print(\"cooled_down\")
		print(current_cooldown_timer)

func use():
	var enemies : = range_area.get_overlapping_bodies()
	var counter : = 0
	for enemy in enemies:
		effect.activate(enemy)
		counter += 1
		if counter >= pierce:
			break
	ready_to_use = false
"

[sub_resource type="GDScript" id="GDScript_ec8im"]
script/source = "extends Node2D

@export var effects : Array[String]
#@export var effects_ : Dictionary[String, int]
@export var strength : = 10

func activate(other : PhysicsBody2D) -> void:
	for effect in effects:
		Callable(self, effect).call(other)
		#print_debug(\"{0} called on {1}\".format([effect, other.name]))
		#Callable(other, effect).call(effects[effect])

func deal_damage(other) -> void:
	other.damage(strength)

func knockback(other) -> void:
	other.knockback(strength)
"

