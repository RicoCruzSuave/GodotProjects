[sub_resource type="GDScript" id="GDScript_dwr7x"]
script/source = "extends CharacterBody2D

@onready var animation_player: AnimationPlayer = $Visuals/SubViewportContainer/SubViewport/Node2D/AnimationPlayer
var stamina : = 1.0
var pause : = 0.1
var up : = false

func _ready() -> void:
	animation_player.animation_finished.connect(lift_cycle)
	lift_cycle(\"\")

func lift_cycle(_arg):
	if up:
		animation_player.play(\"lifting\", -1, -pow(stamina, 3.0), true)
	else:
		animation_player.play(\"lifting\", -1, pow(stamina, 1.0))
	stamina -= 0.01
	up = not up
	print(stamina)
"

