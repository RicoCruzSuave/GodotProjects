[sub_resource type="GDScript" id="GDScript_56xql"]
script/source = "@tool
extends Node3D

@export var input_anim : String
@export var output_anim : String

@export_range(0, 100) var blend : = 0.0 :
	set = set_blend

@onready var animation_tree: AnimationTree = $AnimationTree

func set_blend(new_blend : float) -> void:
	blend = new_blend
	var anim_tree_res : AnimationNodeBlendTree = $AnimationTree.tree_root
	anim_tree_res.set_parameter(\"blend\", float(blend/100.0))
	anim_tree_res.set_parameter(\"Input\", input_anim)
	anim_tree_res.set_parameter(\"Output\", output_anim)
"

