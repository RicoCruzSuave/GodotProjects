[sub_resource type="GDScript" id="GDScript_71c6e"]
script/source = "@tool
extends Line2D


func _ready():
	points.resize(2)
	_compute_points()
	item_rect_changed.connect(_compute_points)
	get_parent().item_rect_changed.connect(_compute_points)

func _process(_delta):
	_compute_points()

func _compute_points():
	points[0] = to_local(get_parent().global_position)
	points[1] = Vector2.ZERO
"

