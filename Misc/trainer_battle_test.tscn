script/source = "extends Node2D

##Name of Species
@export var species_name : = \"Test\"
##The personalized name of this creature
@export var individual_name : = \"Test\"
##How much space they take up on the board
@export var size : = Vector2i.ONE
##The type of creature they are
@export var type : = \"???\"
##What form they take
@export var form : = \"???\"
##I don't know man, temp forms for megas or something
@export var transient_form : = \"???\"
##A selection of three abilities
@export var abilities : = [null, null, null]
##Up to three held items
@export var items : = [null, null, null]

#Battle Stats
@export var base_health : = 100
@export var base_speed : = 100
